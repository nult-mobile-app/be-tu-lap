# ─── Telegram Donate Bot ─────────────────────────────────────────────────────
# Sao chép file này thành .env rồi điền giá trị thật vào

# Tạo bot tại https://t.me/BotFather → nhắn /newbot → lấy token bên dưới
EXPO_PUBLIC_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Chat ID của bạn (hoặc group). Lấy bằng cách: gửi /start cho bot rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates → tìm "chat":{"id":...}
EXPO_PUBLIC_TELEGRAM_CHAT_ID=YOUR_CHAT_ID
